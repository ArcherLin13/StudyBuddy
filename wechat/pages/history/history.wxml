<view class="page safe-bottom">
  <view class="card" wx:for="{{weeks}}" wx:key="weekId">
    <view class="head" data-id="{{item.weekId}}" bindtap="onToggle">
      <view>
        <text class="title">{{item.isCurrent ? '本周' : item.rangeText}}</text>
        <text class="sub" wx:if="{{item.isCurrent}}">{{item.rangeText}}</text>
        <text class="meta">总时长 {{item.durationText}}</text>
      </view>
      <view class="score-wrap">
        <text class="score">{{item.score}}</text>
        <text class="grade">{{item.grade}}</text>
      </view>
    </view>

    <view wx:if="{{item.expanded}}" class="detail">
      <view class="parts">
        <view>时长分 {{item.timeScore}} / 60</view>
        <view>稳定分 {{item.stabilityScore}} / 25</view>
        <view>连击分 {{item.comboScore}} / 15（连续 {{item.streakDays}} 天）</view>
      </view>

      <view class="block-title">每天</view>
      <view class="day" wx:for="{{item.daily}}" wx:for-item="day" wx:key="date">
        <text class="wk">周{{day.weekday}}</text>
        <text class="dur">{{day.seconds ? day.durationText : '未学习'}}</text>
      </view>

      <view class="block-title">科目</view>
      <view wx:if="{{item.subjects.length === 0}}" class="empty">本周还没有记录</view>
      <view class="day" wx:for="{{item.subjects}}" wx:for-item="sub" wx:key="name">
        <text class="wk">{{sub.name}}</text>
        <text class="dur">{{sub.durationText}}</text>
      </view>
    </view>
  </view>
</view>
