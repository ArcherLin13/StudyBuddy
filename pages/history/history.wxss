.page {
  padding: 24rpx 32rpx 48rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8680;
}

.score-wrap {
  text-align: right;
}

.score {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1;
}

.grade {
  font-size: 22rpx;
  color: #c45c26;
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8680;
}

.detail {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #efece4;
}

.parts {
  display: flex;
  flex-direction: column;
  font-size: 24rpx;
  color: #8a8680;
  line-height: 1.8;
}

.block-title {
  margin: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #8a8680;
}

.day {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}

.wk {
  color: #2c2a26;
}

.dur {
  color: #8a8680;
}

.empty {
  font-size: 26rpx;
  color: #8a8680;
  padding: 8rpx 0 16rpx;
}
